generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  CONTRIBUTOR
  VIEWER
}

enum AssetType {
  PHOTO
  DOCUMENT
  AUDIO
  VIDEO
  OTHER
}

enum FindingStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

enum WorkspaceMode {
  FAMILY
  CREATOR
  BUSINESS
  CHURCH
  EVENT
  COACH
  TEACHER
  GROUP
}

enum EventStepPhase {
  BEFORE
  DURING
  AFTER
}

enum EventStepType {
  MESSAGE
  MEDIA
  CHECK_IN
  MEETING
  TASK
  ANNOUNCEMENT
  QR
  LESSON
  PAYMENT
  CUSTOM
}

enum EventStepStatus {
  PENDING
  READY
  ACTIVE
  DONE
  SKIPPED
}

enum CreatorCreationKind {
  DIGITAL_PRODUCT
  VIDEO_SERIES
  EVENT_KIT
  SERVICE_OFFER
  BRAND
  BUSINESS
}

enum CreatorCreationStatus {
  DRAFT
  BUILDING
  COMPLETE
  ARCHIVED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  displayName          String?
  memberships          Membership[]
  workspaceMemberships WorkspaceMember[]
  creatorProfiles      CreatorProfile[]
  creatorCreations     CreatorCreation[]
  creatorFamilies      CreatorFamily[]
  creatorTemplates     CreatorTemplate[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  tagline          String?
  mode             WorkspaceMode     @default(FAMILY)
  members          WorkspaceMember[]
  families         Family[]
  people           Person[]
  groups           Group[]
  events           Event[]
  creatorProfiles  CreatorProfile[]
  creatorCreations CreatorCreation[]
  creatorFamilies  CreatorFamily[]
  creatorTemplates CreatorTemplate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model WorkspaceMember {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(CONTRIBUTOR)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Family {
  id          String       @id @default(cuid())
  name        String
  tagline     String?
  coverImage  String?
  memberships Membership[]
  people      Person[]
  assets      Asset[]
  events      Event[]
  places      Place[]
  questions   Question[]
  tasks       Task[]
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(CONTRIBUTOR)
  userId    String
  familyId  String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, familyId])
}

model Person {
  id               String          @id @default(cuid())
  familyId         String?
  family           Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName        String
  middleName       String?
  lastName         String?
  nickname         String?
  birthDate        DateTime?
  deathDate        DateTime?
  birthPlace       String?
  summary          String?
  portraitUrl      String?
  assetLinks       AssetPerson[]
  relationsA       Relationship[]  @relation("PersonA")
  relationsB       Relationship[]  @relation("PersonB")
  groupMemberships GroupMember[]
  workspaceId      String?
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId])
  @@index([familyId])
}

model Relationship {
  id        String   @id @default(cuid())
  familyId  String
  personAId String
  personBId String
  type      String
  personA   Person   @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person   @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([familyId])
}

model Asset {
  id           String        @id @default(cuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  type         AssetType
  title        String?
  storageUrl   String
  thumbnailUrl String?
  description  String?
  capturedAt   DateTime?
  sourceLabel  String?
  personLinks  AssetPerson[]
  findings     AiFinding[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AssetPerson {
  id       String @id @default(cuid())
  assetId  String
  personId String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model AiFinding {
  id         String          @id @default(cuid())
  assetId    String
  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind       String
  value      String
  confidence ConfidenceLevel @default(MEDIUM)
  status     FindingStatus   @default(SUGGESTED)
  createdAt  DateTime        @default(now())
}

model Event {
  id          String          @id @default(cuid())
  familyId    String?
  family      Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String
  description String?
  occurredAt  DateTime?
  startsAt    DateTime?
  endsAt      DateTime?
  type        String          @default("CUSTOM")
  confidence  ConfidenceLevel @default(MEDIUM)
  steps       EventStep[]
  createdAt   DateTime        @default(now())

  @@index([familyId])
  @@index([workspaceId, startsAt])
}

model EventStep {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phase       EventStepPhase
  type        EventStepType
  status      EventStepStatus @default(PENDING)
  title       String
  description String?
  scheduledAt DateTime?
  sortOrder   Int             @default(0)
  payload     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([eventId, phase, sortOrder])
  @@index([scheduledAt])
}

model Group {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  members     GroupMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  personId  String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, personId])
  @@index([personId])
}

model Place {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  region    String?
  country   String?
  createdAt DateTime @default(now())
}

model Question {
  id         String          @id @default(cuid())
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  prompt     String
  assignedTo String?
  status     String          @default("OPEN")
  answer     String?
  confidence ConfidenceLevel @default(LOW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actionType  String
  title       String
  description String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreatorProfile {
  id              String            @id @default(cuid())
  userId          String
  workspaceId     String?
  defaultAudience String?
  defaultVoice    String?
  defaultLook     String?
  goals           Json?
  creationTypes   Json?
  preferences     Json?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandKits       CreatorBrandKit[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model CreatorBrandKit {
  id        String            @id @default(cuid())
  profileId String
  name      String
  type      String?
  audience  String?
  voice     String?
  look      String?
  colors    Json?
  assets    Json?
  avoid     Json?
  footer    String?
  notes     String?
  profile   CreatorProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  creations CreatorCreation[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([profileId])
}

model CreatorCreation {
  id            String                @id @default(cuid())
  userId        String
  workspaceId   String?
  kind          CreatorCreationKind
  status        CreatorCreationStatus @default(BUILDING)
  title         String
  format        String?
  style         String?
  currentStep   String?
  progress      Int                   @default(0)
  schemaVersion Int                   @default(1)
  revision      Int                   @default(1)
  payload       Json
  parentId      String?
  familyId      String?
  sourceId      String?
  brandKitId    String?
  completedAt   DateTime?
  archivedAt    DateTime?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  parent        CreatorCreation?      @relation("CreatorParent", fields: [parentId], references: [id], onDelete: SetNull)
  children      CreatorCreation[]     @relation("CreatorParent")
  family        CreatorFamily?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  source        CreatorCreation?      @relation("CreatorSource", fields: [sourceId], references: [id], onDelete: SetNull)
  derivatives   CreatorCreation[]     @relation("CreatorSource")
  brandKit      CreatorBrandKit?      @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  linksFrom     CreatorCreationLink[] @relation("LinkFrom")
  linksTo       CreatorCreationLink[] @relation("LinkTo")
  templates     CreatorTemplate[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId, status, updatedAt])
  @@index([workspaceId, status, updatedAt])
  @@index([kind, status])
  @@index([familyId])
  @@index([parentId])
  @@index([sourceId])
}

model CreatorFamily {
  id          String            @id @default(cuid())
  userId      String
  workspaceId String?
  title       String
  rootId      String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  creations   CreatorCreation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([rootId])
}

model CreatorCreationLink {
  id        String          @id @default(cuid())
  fromId    String
  toId      String
  relation  String
  sortOrder Int             @default(0)
  from      CreatorCreation @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        CreatorCreation @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([fromId, toId, relation])
  @@index([toId])
}

model CreatorTemplate {
  id            String              @id @default(cuid())
  userId        String
  workspaceId   String?
  sourceId      String?
  kind          CreatorCreationKind
  title         String
  format        String?
  style         String?
  schemaVersion Int                 @default(1)
  seed          Json
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  source        CreatorCreation?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, kind])
  @@index([workspaceId, kind])
  @@index([sourceId])
}
