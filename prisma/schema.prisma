generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  VIEWER
}

enum AssetType {
  PHOTO
  DOCUMENT
  AUDIO
  VIDEO
  OTHER
}

enum FindingStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

enum ContactChannel {
  EMAIL
  SMS
  VOICE
  SOCIAL
  OTHER
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
  NOT_REQUIRED
}

enum LeadStage {
  NEW
  ENGAGED
  QUALIFIED
  PROPOSAL
  CUSTOMER
  REPEAT_CUSTOMER
  EARN_CANDIDATE
  EARN_ACTIVE
  CLOSED_LOST
}

enum RevenueAgentRole {
  MARKETING_DIRECTOR
  SALES_DIRECTOR
  SALES_SPECIALIST
  SOCIAL_SPECIALIST
  OUTBOUND_SPECIALIST
  VOICE_AGENT
  EARN_COACH
  CUSTOMER_SUCCESS
}

enum RevenueEventType {
  VISIT
  TRY_STARTED
  TRY_COMPLETED
  BLUEPRINT_CREATED
  BLUEPRINT_SAVED
  LEAD_CAPTURED
  CONSENT_CHANGED
  SALES_TOUCH
  VOICE_INTERACTION
  SOCIAL_ENGAGEMENT
  CHECKOUT_STARTED
  PURCHASE
  BOT_LAUNCHED
  FIRST_MISSION
  GIFT
  SECOND_BOT
  EARN_INTEREST
  EARN_QUALIFIED
  REFERRAL_SALE
  OPT_OUT
}

enum EarnStatus {
  NOT_APPLIED
  INTERESTED
  REVIEWING
  QUALIFIED
  ACTIVE
  PAUSED
  DISQUALIFIED
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Family {
  id          String       @id @default(cuid())
  name        String
  tagline     String?
  coverImage  String?
  memberships Membership[]
  people      Person[]
  assets      Asset[]
  events      Event[]
  places      Place[]
  questions   Question[]
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(CONTRIBUTOR)
  userId    String
  familyId  String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, familyId])
}

model Person {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName   String
  middleName  String?
  lastName    String?
  nickname    String?
  birthDate   DateTime?
  deathDate   DateTime?
  birthPlace  String?
  summary     String?
  portraitUrl String?
  assetLinks  AssetPerson[]
  relationsA  Relationship[] @relation("PersonA")
  relationsB  Relationship[] @relation("PersonB")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Relationship {
  id        String   @id @default(cuid())
  familyId  String
  personAId String
  personBId String
  type      String
  personA   Person   @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person   @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([familyId])
}

model Asset {
  id           String        @id @default(cuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  type         AssetType
  title        String?
  storageUrl   String
  thumbnailUrl String?
  description  String?
  capturedAt   DateTime?
  sourceLabel  String?
  personLinks  AssetPerson[]
  findings     AiFinding[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AssetPerson {
  id       String @id @default(cuid())
  assetId  String
  personId String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model AiFinding {
  id         String          @id @default(cuid())
  assetId    String
  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind       String
  value      String
  confidence ConfidenceLevel @default(MEDIUM)
  status     FindingStatus   @default(SUGGESTED)
  createdAt  DateTime        @default(now())
}

model Event {
  id          String          @id @default(cuid())
  familyId    String
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  occurredAt  DateTime?
  confidence  ConfidenceLevel @default(MEDIUM)
  createdAt   DateTime        @default(now())
}

model Place {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  region    String?
  country   String?
  createdAt DateTime @default(now())
}

model Question {
  id         String          @id @default(cuid())
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  prompt     String
  assignedTo String?
  status     String          @default("OPEN")
  answer     String?
  confidence ConfidenceLevel @default(LOW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actionType  String
  title       String
  description String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// BOT FACTORY REVENUE SPINE
// Internal operating data for marketing, sales, voice, customer success and
// Earn Mode. These models do not create new public Factory districts or bots.
// -----------------------------------------------------------------------------

model Prospect {
  id            String          @id @default(cuid())
  displayName   String?
  email         String?
  phone         String?
  companyName   String?
  source        String?
  stage         LeadStage       @default(NEW)
  preferredBot  String?
  lastTouchAt   DateTime?
  nextActionAt  DateTime?
  consent       ConsentRecord[]
  events        RevenueEvent[]
  opportunities SalesOpportunity[]
  entitlements  BotEntitlement[]
  earn          EarnEnrollment?
  voiceCalls    VoiceInteraction[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([stage])
  @@index([email])
  @@index([phone])
}

model ConsentRecord {
  id          String        @id @default(cuid())
  prospectId  String
  prospect    Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  channel     ContactChannel
  status      ConsentStatus @default(UNKNOWN)
  scope       String?
  source      String?
  evidenceRef String?
  capturedAt  DateTime      @default(now())
  expiresAt   DateTime?
  updatedAt   DateTime      @updatedAt

  @@index([prospectId, channel])
}

model RevenueEvent {
  id         String           @id @default(cuid())
  prospectId String?
  prospect   Prospect?        @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  sessionId  String?
  type       RevenueEventType
  botId      String?
  agentRole  RevenueAgentRole?
  source     String?
  campaign   String?
  metadata   Json?
  occurredAt DateTime         @default(now())

  @@index([prospectId, occurredAt])
  @@index([type, occurredAt])
  @@index([campaign])
}

model SalesOpportunity {
  id              String    @id @default(cuid())
  prospectId      String
  prospect        Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  title           String
  stage           LeadStage @default(QUALIFIED)
  botIds          String[]
  estimatedCents  Int?
  probabilityPct  Int?
  assignedRole    RevenueAgentRole?
  nextAction      String?
  nextActionAt    DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lossReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stage, nextActionAt])
  @@index([prospectId])
}

model BotEntitlement {
  id          String    @id @default(cuid())
  prospectId  String
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  botId       String
  orderRef    String?
  status      String    @default("PENDING")
  activatedAt DateTime?
  firstUseAt  DateTime?
  lastUseAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([prospectId, botId])
  @@index([status])
}

model EarnEnrollment {
  id               String      @id @default(cuid())
  prospectId       String      @unique
  prospect         Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  status           EarnStatus  @default(NOT_APPLIED)
  referralCode     String?     @unique
  commissionTier   String?
  qualifiedAt      DateTime?
  activatedAt      DateTime?
  pausedAt         DateTime?
  qualificationRef String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
}

model VoiceInteraction {
  id                 String           @id @default(cuid())
  prospectId         String
  prospect           Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  direction          String
  agentRole          RevenueAgentRole @default(VOICE_AGENT)
  consentVerified    Boolean          @default(false)
  recordingAllowed   Boolean          @default(false)
  disposition        String?
  conversationSummary String?
  recommendedBotIds  String[]
  nextAction         String?
  startedAt          DateTime         @default(now())
  endedAt            DateTime?

  @@index([prospectId, startedAt])
  @@index([disposition])
}
