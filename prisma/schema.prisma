generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  CONTRIBUTOR
  VIEWER
}

enum AssetType {
  PHOTO
  DOCUMENT
  AUDIO
  VIDEO
  OTHER
}

enum FindingStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

enum WorkspaceMode {
  FAMILY
  CREATOR
  BUSINESS
  CHURCH
  EVENT
  COACH
  TEACHER
  GROUP
}

enum EventStepPhase {
  BEFORE
  DURING
  AFTER
}

enum EventStepType {
  MESSAGE
  MEDIA
  CHECK_IN
  MEETING
  TASK
  ANNOUNCEMENT
  QR
  LESSON
  PAYMENT
  CUSTOM
}

enum EventStepStatus {
  PENDING
  READY
  ACTIVE
  DONE
  SKIPPED
}

enum FastPayProvider {
  STRIPE
  SHOPIFY
  INTERNAL
}

enum FastPayTransactionStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  DISPUTED
  FAILED
}

enum FastPayEntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FastPayReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum CreatorCreationKind {
  DIGITAL_PRODUCT
  VIDEO_SERIES
  EVENT_KIT
  SERVICE_OFFER
  BRAND
  BUSINESS
}

enum CreatorCreationStatus {
  DRAFT
  BUILDING
  COMPLETE
  ARCHIVED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  displayName          String?
  memberships          Membership[]
  workspaceMemberships WorkspaceMember[]
  creatorProfiles      CreatorProfile[]
  creatorCreations     CreatorCreation[]
  creatorFamilies      CreatorFamily[]
  creatorTemplates     CreatorTemplate[]
  fastPayAccount       FastPayAccount?
  wmrProfile           WmrProfile?
  wmrEvents            WmrEvent[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  tagline          String?
  mode             WorkspaceMode     @default(FAMILY)
  members          WorkspaceMember[]
  families         Family[]
  people           Person[]
  groups           Group[]
  events           Event[]
  creatorProfiles  CreatorProfile[]
  creatorCreations CreatorCreation[]
  creatorFamilies  CreatorFamily[]
  creatorTemplates CreatorTemplate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model WorkspaceMember {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(CONTRIBUTOR)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Family {
  id          String       @id @default(cuid())
  name        String
  tagline     String?
  coverImage  String?
  memberships Membership[]
  people      Person[]
  assets      Asset[]
  events      Event[]
  places      Place[]
  questions   Question[]
  tasks       Task[]
  workspaceId String?
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole @default(CONTRIBUTOR)
  userId    String
  familyId  String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, familyId])
}

model Person {
  id               String         @id @default(cuid())
  familyId         String?
  family           Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName        String
  middleName       String?
  lastName         String?
  nickname         String?
  birthDate        DateTime?
  deathDate        DateTime?
  birthPlace       String?
  summary          String?
  portraitUrl      String?
  assetLinks       AssetPerson[]
  relationsA       Relationship[] @relation("PersonA")
  relationsB       Relationship[] @relation("PersonB")
  groupMemberships GroupMember[]
  workspaceId      String?
  workspace        Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workspaceId])
  @@index([familyId])
}

model Relationship {
  id        String   @id @default(cuid())
  familyId  String
  personAId String
  personBId String
  type      String
  personA   Person   @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person   @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([familyId])
}

model Asset {
  id           String        @id @default(cuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  type         AssetType
  title        String?
  storageUrl   String
  thumbnailUrl String?
  description  String?
  capturedAt   DateTime?
  sourceLabel  String?
  personLinks  AssetPerson[]
  findings     AiFinding[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AssetPerson {
  id       String @id @default(cuid())
  assetId  String
  personId String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model AiFinding {
  id         String          @id @default(cuid())
  assetId    String
  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind       String
  value      String
  confidence ConfidenceLevel @default(MEDIUM)
  status     FindingStatus   @default(SUGGESTED)
  createdAt  DateTime        @default(now())
}

model Event {
  id          String          @id @default(cuid())
  familyId    String?
  family      Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String
  description String?
  occurredAt  DateTime?
  startsAt    DateTime?
  endsAt      DateTime?
  type        String          @default("CUSTOM")
  confidence  ConfidenceLevel @default(MEDIUM)
  steps       EventStep[]
  createdAt   DateTime        @default(now())

  @@index([familyId])
  @@index([workspaceId, startsAt])
}

model EventStep {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phase       EventStepPhase
  type        EventStepType
  status      EventStepStatus @default(PENDING)
  title       String
  description String?
  scheduledAt DateTime?
  sortOrder   Int             @default(0)
  payload     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([eventId, phase, sortOrder])
  @@index([scheduledAt])
}

model Group {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  members     GroupMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  personId  String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, personId])
  @@index([personId])
}

model Place {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  region    String?
  country   String?
  createdAt DateTime @default(now())
}

model Question {
  id         String          @id @default(cuid())
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  prompt     String
  assignedTo String?
  status     String          @default("OPEN")
  answer     String?
  confidence ConfidenceLevel @default(LOW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actionType  String
  title       String
  description String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreatorProfile {
  id              String            @id @default(cuid())
  userId          String
  workspaceId     String?
  defaultAudience String?
  defaultVoice    String?
  defaultLook     String?
  goals           Json?
  creationTypes   Json?
  preferences     Json?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandKits       CreatorBrandKit[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

model CreatorBrandKit {
  id        String            @id @default(cuid())
  profileId String
  name      String
  type      String?
  audience  String?
  voice     String?
  look      String?
  colors    Json?
  assets    Json?
  avoid     Json?
  footer    String?
  notes     String?
  profile   CreatorProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  creations CreatorCreation[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([profileId])
}

model CreatorCreation {
  id              String                @id @default(cuid())
  userId          String
  workspaceId     String?
  kind            CreatorCreationKind
  status          CreatorCreationStatus @default(BUILDING)
  title           String
  format          String?
  style           String?
  currentStep     String?
  progress        Int                   @default(0)
  schemaVersion   Int                   @default(1)
  revision        Int                   @default(1)
  payload         Json
  parentId        String?
  familyId        String?
  sourceId        String?
  brandKitId      String?
  completedAt     DateTime?
  archivedAt      DateTime?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  parent          CreatorCreation?      @relation("CreatorParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        CreatorCreation[]     @relation("CreatorParent")
  family          CreatorFamily?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  rootForFamilies CreatorFamily[]       @relation("CreatorFamilyRoot")
  source          CreatorCreation?      @relation("CreatorSource", fields: [sourceId], references: [id], onDelete: SetNull)
  derivatives     CreatorCreation[]     @relation("CreatorSource")
  brandKit        CreatorBrandKit?      @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  linksFrom       CreatorCreationLink[] @relation("LinkFrom")
  linksTo         CreatorCreationLink[] @relation("LinkTo")
  templates       CreatorTemplate[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, status, updatedAt])
  @@index([workspaceId, status, updatedAt])
  @@index([kind, status])
  @@index([familyId])
  @@index([parentId])
  @@index([sourceId])
}

model CreatorFamily {
  id          String            @id @default(cuid())
  userId      String
  workspaceId String?
  title       String
  rootId      String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  root        CreatorCreation?  @relation("CreatorFamilyRoot", fields: [rootId], references: [id], onDelete: SetNull)
  creations   CreatorCreation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([rootId])
}

model CreatorCreationLink {
  id        String          @id @default(cuid())
  fromId    String
  toId      String
  relation  String
  sortOrder Int             @default(0)
  from      CreatorCreation @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        CreatorCreation @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([fromId, toId, relation])
  @@index([toId])
}

model CreatorTemplate {
  id            String              @id @default(cuid())
  userId        String
  workspaceId   String?
  sourceId      String?
  kind          CreatorCreationKind
  title         String
  format        String?
  style         String?
  schemaVersion Int                 @default(1)
  seed          Json
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  source        CreatorCreation?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, kind])
  @@index([workspaceId, kind])
  @@index([sourceId])
}

model InstitutionalInquiry {
  id               String   @id @default(cuid())
  name             String
  email            String
  organization     String
  role             String?
  organizationType String
  participantCount String?
  goals            String
  status           String   @default("NEW")
  source           String   @default("creator-college-institutions")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email, createdAt])
  @@index([organizationType, createdAt])
  @@index([status, createdAt])
}

model FastPayAccount {
  id               String                    @id @default(cuid())
  userId           String                    @unique
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?                   @unique
  entitlements     FastPayEntitlement[]
  transactions     FastPayTransaction[]
  ledgerEntries    FastPayLedgerEntry[]
  reservations     FastPayUsageReservation[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model FastPayActionDefinition {
  id            String                    @id @default(cuid())
  key           String                    @unique
  singularLabel String
  pluralLabel   String
  defaultCost   Int                       @default(1)
  active        Boolean                   @default(true)
  entitlements  FastPayEntitlement[]
  offers        FastPayOffer[]
  reservations  FastPayUsageReservation[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model FastPayOffer {
  id              String                   @id @default(cuid())
  key             String                   @unique
  name            String
  description     String?
  provider        FastPayProvider          @default(STRIPE)
  providerPriceId String?
  amountCents     Int
  currency        String                   @default("usd")
  actionKey       String?
  action          FastPayActionDefinition? @relation(fields: [actionKey], references: [key], onDelete: SetNull)
  grantUnits      Int                      @default(0)
  grantsUnlimited Boolean                  @default(false)
  offerStyle      String                   @default("BUY")
  active          Boolean                  @default(false)
  transactions    FastPayTransaction[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([actionKey, active])
}

model FastPayTransaction {
  id                 String                   @id @default(cuid())
  accountId          String
  account            FastPayAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  offerId            String
  offer              FastPayOffer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  provider           FastPayProvider
  status             FastPayTransactionStatus @default(PENDING)
  amountCents        Int
  currency           String
  idempotencyKey     String                   @unique
  externalCheckoutId String?                  @unique
  externalPaymentId  String?                  @unique
  paidAt             DateTime?
  entitlements       FastPayEntitlement[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model FastPayEntitlement {
  id                  String                    @id @default(cuid())
  accountId           String
  account             FastPayAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actionKey           String
  action              FastPayActionDefinition   @relation(fields: [actionKey], references: [key], onDelete: Restrict)
  sourceTransactionId String?
  sourceTransaction   FastPayTransaction?       @relation(fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  unitsGranted        Int                       @default(0)
  unitsRemaining      Int                       @default(0)
  unlimited           Boolean                   @default(false)
  status              FastPayEntitlementStatus  @default(ACTIVE)
  expiresAt           DateTime?
  version             Int                       @default(0)
  ledgerEntries       FastPayLedgerEntry[]
  reservations        FastPayUsageReservation[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([accountId, actionKey, status])
  @@index([sourceTransactionId])
}

model FastPayLedgerEntry {
  id             String              @id @default(cuid())
  accountId      String
  account        FastPayAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entitlementId  String?
  entitlement    FastPayEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  deltaUnits     Int
  balanceAfter   Int
  reason         String
  referenceType  String?
  referenceId    String?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())

  @@index([accountId, createdAt])
  @@index([entitlementId, createdAt])
}

model FastPayUsageReservation {
  id             String                   @id @default(cuid())
  accountId      String
  account        FastPayAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entitlementId  String
  entitlement    FastPayEntitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  actionKey      String
  action         FastPayActionDefinition  @relation(fields: [actionKey], references: [key], onDelete: Restrict)
  units          Int
  status         FastPayReservationStatus @default(RESERVED)
  idempotencyKey String                   @unique
  expiresAt      DateTime
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([accountId, actionKey, status])
  @@index([status, expiresAt])
}

model FastPayProcessedEvent {
  id              String          @id @default(cuid())
  provider        FastPayProvider
  externalEventId String
  eventType       String
  status          String
  errorCode       String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
}


model WmrProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planState            Json?
  wmrBase              Boolean  @default(false)
  forReal              Boolean  @default(false)
  bwfPassport          Boolean  @default(false)
  vipMe                Boolean  @default(false)
  entitlementCheckedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WmrEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventName String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventName, createdAt])
}

model PgpOpportunity {
  id                String                @id @default(cuid())
  memberKey         String
  environment       String
  observation       String
  structuredProblem String?
  productName       String?
  fitState          String?
  status            String                @default("SPOTTED")
  attentionState    String                @default("NOTHING_TO_DO")
  palaceKeyCode     String?
  events            PgpOpportunityEvent[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([memberKey, createdAt])
  @@index([status, updatedAt])
}

model PgpOpportunityEvent {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   PgpOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String
  payload       Json?
  createdAt     DateTime       @default(now())

  @@index([opportunityId, createdAt])
}

model PgpPalaceKey {
  id             String   @id @default(cuid())
  code           String   @unique
  memberKey      String
  opportunityId  String?
  keyType        String   @default("QUICK")
  contextType    String?
  productName    String?
  destination    String
  attributionKey String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([memberKey, createdAt])
  @@index([opportunityId])
  @@index([attributionKey])
}

model PgpKeyEvent {
  id        String   @id @default(cuid())
  keyCode   String
  eventType String
  sessionId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([keyCode, createdAt])
}


model PgpEarnAttribution {
  id                    String   @id @default(cuid())
  memberKey             String
  keyCode               String
  opportunityId         String?
  productName           String?
  conversionRef         String?  @unique
  provider              String   @default("EARN_MODE")
  providerStatus        String   @default("PENDING_HANDOFF")
  grossAmountCents      Int?
  eligibleAmountCents   Int?
  commissionAmountCents Int?
  payload               Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([memberKey, createdAt])
  @@index([keyCode, createdAt])
  @@index([providerStatus, createdAt])
}


model PgpLead {
  id          String   @id @default(cuid())
  email       String
  displayName String?
  source      String   @default("pgp")
  status      String   @default("EARLY_ACCESS")
  guideId     String?
  naturalPower String?
  supportingPower String?
  expansionPower String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, source])
  @@index([status, createdAt])
  @@index([source, createdAt])
}


model HubLeaderLead {
  id               String   @id @default(cuid())
  lane             String
  name             String
  email            String
  organization     String?
  role             String?
  cohort           String?
  hardwareInterest String?
  source           String   @default("hub-leaders")
  status           String   @default("NEW")
  payload          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([email, lane])
  @@index([lane, status, createdAt])
  @@index([email, createdAt])
}
