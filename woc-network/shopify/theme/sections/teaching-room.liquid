<section id="teaching-room" class="woc-module "><div class="woc-inner"><p class="eyebrow">{{ 'woc_final.teaching.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.deck | escape }}</p><div class="actions"><a class="btn" href="#cole-{{ section.id }}">{{ 'woc_final.teaching.enter' | t }}</a></div><img class="teaching-environment" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/teaching-room-editorial-interior.png?v=1789349335" alt="An inviting setting for Bible study and teaching" width="1400" height="900" loading="lazy"><div class="grid"><article class="card" id="cole-{{ section.id }}">{% if section.settings.cole_image != blank %}{{ section.settings.cole_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'portrait' }}{% else %}<div class="monogram" aria-hidden="true">TC</div>{% endif %}<p class="eyebrow">{{ 'woc_final.teaching.teacher' | t }}</p><h3>{{ 'woc_final.teaching.cole' | t }}</h3><p>{{ 'woc_final.teaching.cole_copy' | t }}</p><details><summary>{{ 'woc_final.teaching.cole_prompt' | t }}</summary><p>{{ 'woc_final.teaching.cole_lesson' | t }}</p><a class="btn" href="#jordan-{{ section.id }}">{{ 'woc_final.teaching.next' | t }}</a></details>{% if section.settings.cole_link != blank %}<a class="btn" href="{{ section.settings.cole_link }}">{{ 'woc_final.teaching.cole_link' | t }}</a>{% endif %}</article><article class="card" id="jordan-{{ section.id }}">{% if section.settings.jordan_image != blank %}{{ section.settings.jordan_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'portrait' }}{% else %}<div class="monogram" aria-hidden="true">MJ</div>{% endif %}<p class="eyebrow">{{ 'woc_final.teaching.bridge' | t }}</p><h3>{{ 'woc_final.teaching.jordan' | t }}</h3><p>{{ 'woc_final.teaching.jordan_copy' | t }}</p><details><summary>{{ 'woc_final.teaching.jordan_prompt' | t }}</summary><p>{{ 'woc_final.teaching.jordan_lesson' | t }}</p><a class="btn" href="#tree-life-application">{{ 'woc_final.teaching.apply' | t }}</a></details>{% if section.settings.jordan_link != blank %}<a class="btn" href="{{ section.settings.jordan_link }}">{{ 'woc_final.teaching.jordan_link' | t }}</a>{% endif %}</article></div></div></section>
{% stylesheet %}
 .woc-module{padding:76px 0;background:#f7efe4;color:#321d30}.woc-module.dark{background:radial-gradient(ellipse at top right,#48213d,transparent 65%),#170e1c;color:#fff5e7}.woc-module .woc-inner{width:min(1280px,calc(100% - 40px));margin:auto}.woc-module h2{font:clamp(38px,5.5vw,76px)/1.04 Georgia,serif;color:inherit;margin:12px 0 22px;letter-spacing:-.035em}.woc-module h3{font:32px/1.1 Georgia,serif;color:inherit;margin:10px 0 18px}.woc-module p{font-size:18px;line-height:1.65}.woc-module .eyebrow{font:700 12px/1.5 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#79591e}.woc-module.dark .eyebrow{color:#e1c27b}.woc-module .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.woc-module .card{padding:30px;border:1px solid #b4977955;border-radius:22px;background:#ffffff09}.woc-module .actions{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.woc-module .btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 24px;border-radius:28px;background:#633453;color:#fff;text-decoration:none;border:1px solid #b49779;cursor:pointer;font:700 16px/1.4 Arial,sans-serif}.woc-module.dark .btn{background:#e3c581;color:#241322}.woc-module label{display:block;font:600 16px/1.5 Arial,sans-serif}.woc-module input,.woc-module select,.woc-module textarea{width:100%;min-height:48px;margin:8px 0 18px;padding:12px;border:1px solid #aa8a76;border-radius:8px;background:#fffaf5;color:#321d30;font:16px/1.5 Arial,sans-serif}.woc-module details{border-top:1px solid #b4977966;padding:20px 0}.woc-module summary{cursor:pointer;font-weight:700;min-height:44px}.woc-module :focus-visible{outline:3px solid #af7c15;outline-offset:5px}.woc-module img{max-width:100%;height:auto;display:block;border-radius:18px}.woc-module .book-image{max-height:590px;width:auto;margin:auto;object-fit:contain}.woc-module .fine{font-size:15px;line-height:1.6}.woc-module .price{font:28px Georgia,serif}.woc-module .portrait{width:100%;height:350px;object-fit:cover}.woc-module .monogram{font:90px Georgia,serif;padding:70px 20px;color:#dfc17a;background:#321d30;text-align:center;border-radius:14px}.woc-module .gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.woc-module .full{grid-column:1/-1}.woc-module [id]{scroll-margin-top:30px}@media(max-width:700px){.woc-module{padding:50px 0}.woc-module .grid,.woc-module .gallery{grid-template-columns:1fr}.woc-module .woc-inner{width:calc(100% - 28px)}.woc-module .card{padding:22px}.woc-module .btn{width:100%}}
{% endstylesheet %}
{% schema %}{"name": "Teaching Room", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "The Teaching Room™"}, {"type": "textarea", "id": "deck", "label": "Introduction", "default": "Teaching excellence. Stronger teachers. Wisdom that reaches the classroom and the community."}, {"type": "image_picker", "id": "cole_image", "label": "Dr. T.T. Cole portrait"}, {"type": "url", "id": "cole_link", "label": "Dr. Cole experience"}, {"type": "image_picker", "id": "jordan_image", "label": "Ms. Jordan portrait"}, {"type": "url", "id": "jordan_link", "label": "Ms. Jordan experience"}], "presets": [{"name": "Teaching Room"}]}{% endschema %}

<style>
#teaching-room{background:linear-gradient(180deg,#0c1110,#000);color:#f5f0f6}#teaching-room .eyebrow{color:#e1c27b}#teaching-room .teaching-environment{width:100%;height:auto;max-height:600px;object-fit:contain;background:#000;margin:32px 0}
</style>

<style>#teaching-room .portrait{height:auto;aspect-ratio:3/4;object-fit:cover;object-position:center 24%;}</style>
