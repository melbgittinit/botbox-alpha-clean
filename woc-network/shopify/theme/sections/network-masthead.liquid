.woc-masthead .woc-logo-capsule{width:148px;flex:0 0 148px;height:55px;aspect-ratio:auto;padding:5px 7px;border-radius:10px;background:#fff;box-shadow:none;backdrop-filter:none}
.woc-logo-capsule:before,.woc-logo-capsule__shine{display:none}.woc-logo-capsule__stage{border-radius:5px}
.woc-masthead .woc-live-orb{width:auto;aspect-ratio:auto;display:flex;gap:10px;padding:10px 0 10px 20px;border:0;border-radius:0;background:none;box-shadow:none;backdrop-filter:none}
.woc-live-orb:after,.woc-live-orb__halo{display:none}
.woc-live-orb .woc-live-orb__pulse{position:relative;top:auto;right:auto;flex:0 0 9px;width:9px;height:9px;background:#41ee83;filter:none;box-shadow:0 0 0 4px #41ee8322;animation:wocOn 1.8s ease-in-out infinite}
.woc-live-orb .woc-live-orb__content{padding:0;text-align:right}.woc-live-orb__label{display:inline;font-size:10px}.woc-live-orb__date{display:inline;margin:0 0 0 10px;font-size:10px}.woc-live-orb__time{font-size:14px;margin-top:5px}
.woc-masthead__center{margin:46px auto 36px}.woc-masthead__nav{margin-top:0}.woc-network-word{font-size:clamp(60px,13.4vw,170px)}
@keyframes wocOn{0%,100%{opacity:1;box-shadow:0 0 0 3px #41ee8322}50%{opacity:.65;box-shadow:0 0 0 7px #41ee8300}}
@media(max-width:540px){.woc-masthead .woc-logo-capsule{width:112px;flex-basis:112px;height:42px}.woc-masthead__top{gap:8px}.woc-live-orb__date{display:block;margin:4px 0 0;font-size:9px}.woc-masthead .woc-live-orb{padding-left:0}.woc-masthead__center{margin:32px auto}.woc-network-word{font-size:15vw}.woc-masthead__nav{grid-template-columns:repeat(4,1fr)}}
@media(prefers-reduced-motion:reduce){.woc-live-orb .woc-live-orb__pulse{animation:none}}

</style>

