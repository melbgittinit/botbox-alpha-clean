<section class="woc-masthead" data-network-masthead>
  <div class="woc-masthead__glow woc-masthead__glow--one" aria-hidden="true"></div>
  <div class="woc-masthead__glow woc-masthead__glow--two" aria-hidden="true"></div>

  <div class="woc-masthead__top">
    <div class="woc-logo-capsule" aria-label="Women of Color">
      <div class="woc-logo-capsule__shine" aria-hidden="true"></div>
      <div class="woc-logo-capsule__stage" data-woc-logo-stage>
        <img class="woc-logo-slide is-active" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_short_hair_orchid.jpg?v=1787984073" alt="Women of Color logo" loading="eager" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_long_braids.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_indeginus.jpg?v=1787984591" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_AFRO_Puffs.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/Women_of_Color_Latina_Profile_Logo.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/Women_of_Color_West_African_Elegance.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_AFRO.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/Women_of_Color_East_Asian_profile_logo.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_YBb_Young_black_braids.jpg?v=1787984420" alt="Women of Color logo" loading="lazy" width="900" height="330">
        <img class="woc-logo-slide" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/South_Asian_elegance_Women_of_Color.jpg?v=1787983217" alt="Women of Color logo" loading="lazy" width="900" height="330">
      </div>
    </div>

    <div class="woc-live-orb" aria-label="Network news status and local time">
      <div class="woc-live-orb__halo" aria-hidden="true"></div>
      <div class="woc-live-orb__pulse" aria-hidden="true"></div>
      <div class="woc-live-orb__content">
        <span class="woc-live-orb__label">{{ 'network_news.empty_label' | t }}</span>
        <span class="woc-live-orb__date" data-network-date>THE NETWORK</span>
        <strong class="woc-live-orb__time" data-network-time>NOW</strong>
      </div>
    </div>
  </div>

  <div class="woc-masthead__center">
    <div class="woc-the">THE</div>
    <h1 class="woc-network-word" aria-label="The Network"><span class="woc-network-letter woc-network-letter--n">N</span><span>ETWOR</span><span class="woc-network-letter woc-network-letter--k">K</span></h1>
    <div class="woc-vine woc-vine--left" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="woc-vine woc-vine--right" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="woc-masthead__tagline"><span>What matters</span><strong>RIGHT NOW</strong></p>
  </div>

  <nav class="woc-masthead__nav" aria-label="The Network topics">
    <a href="#network-stories">NEWS</a><span>CULTURE</span><span>FAITH</span><span>PEOPLE</span><span>HEALTH</span><span>MONEY</span><span>FAMILY</span><span>OPPORTUNITY</span>
  </nav>
  <div class="woc-vine-gather" aria-hidden="true"><span></span><span></span><span></span></div>
</section>

<style>
  .woc-masthead{position:relative;isolation:isolate;overflow:hidden;width:100%;min-height:620px;padding:34px clamp(18px,4vw,64px) 28px;background:radial-gradient(circle at 50% 12%,rgba(35,100,70,.28),transparent 30%),linear-gradient(145deg,#062b20 0%,#0a3a2b 48%,#041f18 100%);color:#fff;border-bottom:1px solid rgba(210,170,72,.45)}
  .woc-masthead:before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 0 28%,rgba(255,255,255,.025) 36%,transparent 45% 100%)}
  .woc-masthead__glow{position:absolute;border-radius:999px;filter:blur(50px);opacity:.22;pointer-events:none}.woc-masthead__glow--one{width:260px;height:260px;left:-80px;top:-60px;background:#b68f33}.woc-masthead__glow--two{width:220px;height:220px;right:-60px;top:30px;background:#12bf78}
  .woc-masthead__top{position:relative;z-index:3;display:flex;justify-content:space-between;align-items:flex-start;gap:20px;max-width:1450px;margin:0 auto}
  .woc-logo-capsule{position:relative;width:clamp(250px,24vw,390px);aspect-ratio:2.85/1;border:1px solid rgba(255,255,255,.34);border-radius:999px;padding:11px 20px;background:linear-gradient(180deg,rgba(255,255,255,.26),rgba(255,255,255,.08));box-shadow:inset 0 1px 0 rgba(255,255,255,.72),inset 0 -14px 28px rgba(0,28,20,.20),0 16px 38px rgba(0,0,0,.27);backdrop-filter:blur(12px)}
  .woc-logo-capsule:before{content:"";position:absolute;inset:8px;border-radius:inherit;background:rgba(255,255,255,.94);box-shadow:inset 0 0 22px rgba(255,255,255,.95);z-index:0}.woc-logo-capsule__shine{position:absolute;z-index:2;left:14%;right:14%;top:7px;height:17%;border-radius:999px;background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(255,255,255,0));pointer-events:none}
  .woc-logo-capsule__stage{position:relative;z-index:1;width:100%;height:100%;overflow:hidden;border-radius:999px}.woc-logo-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center;opacity:0;transform:scale(.985);transition:opacity .55s ease,transform .55s ease}.woc-logo-slide.is-active{opacity:1;transform:scale(1)}
  .woc-live-orb{position:relative;display:grid;place-items:center;width:clamp(150px,13vw,210px);aspect-ratio:1;border-radius:50%;border:1px solid rgba(255,255,255,.42);background:radial-gradient(circle at 34% 24%,rgba(255,255,255,.34),rgba(255,255,255,.08) 35%,rgba(0,38,28,.35) 71%);box-shadow:inset 0 0 25px rgba(255,255,255,.13),0 18px 38px rgba(0,0,0,.3);backdrop-filter:blur(13px)}
  .woc-live-orb:after{content:"";position:absolute;inset:7%;border-radius:50%;border-top:1px solid rgba(255,255,255,.55);transform:rotate(-18deg)}.woc-live-orb__halo{position:absolute;width:62%;height:62%;border-radius:50%;background:rgba(16,219,119,.14);filter:blur(6px);animation:wocPulseHalo 2.1s ease-in-out infinite}.woc-live-orb__pulse{position:absolute;top:18%;right:19%;width:34%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#b8ffd7 0 15%,#22df80 28%,rgba(16,210,109,.22) 67%,transparent 72%);filter:drop-shadow(0 0 10px #31dd87);animation:wocPulse 1.5s ease-in-out infinite}
  .woc-live-orb__content{position:relative;z-index:2;text-align:center;padding-top:26%}.woc-live-orb__label{display:block;font:800 10px/1 sans-serif;letter-spacing:.24em;color:#adffd0}.woc-live-orb__date{display:block;margin-top:8px;font:700 clamp(9px,1vw,12px)/1.3 sans-serif;letter-spacing:.08em;color:#f2e7c4}.woc-live-orb__time{display:block;margin-top:4px;font:900 clamp(16px,1.8vw,26px)/1 sans-serif;color:#fff}
  .woc-masthead__center{position:relative;z-index:2;max-width:1400px;margin:-34px auto 0;text-align:center}.woc-the{font:700 clamp(18px,2.2vw,32px)/1 Georgia,serif;letter-spacing:.42em;padding-left:.42em;color:#ddbc61;text-shadow:0 2px 0 #6e5419,0 5px 12px rgba(0,0,0,.35)}
  .woc-network-word{position:relative;margin:5px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(76px,13.4vw,205px);font-weight:900;line-height:.8;letter-spacing:-.065em;white-space:nowrap;color:#d9ad43;background:linear-gradient(180deg,#fff0a1 0%,#e5bd59 24%,#b9811d 52%,#f0cd6a 72%,#896016 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 4px 0 #6c4a10) drop-shadow(0 8px 2px rgba(0,0,0,.35));text-shadow:0 1px 0 #fff0a3,0 2px 0 #c99831,0 3px 0 #a26d12,0 5px 0 #6d490e,0 10px 18px rgba(0,0,0,.42)}
  .woc-network-letter--n{position:relative}.woc-network-letter--n:after{content:"";position:absolute;left:6%;bottom:4%;width:20%;height:7%;border-radius:999px;background:#b6433e;box-shadow:0 0 8px rgba(182,67,62,.45)}.woc-network-letter--k{position:relative}.woc-network-letter--k:after{content:"";position:absolute;right:4%;top:10%;width:20%;height:7%;border-radius:999px;background:#29925f;box-shadow:0 0 8px rgba(41,146,95,.45)}
  .woc-masthead__tagline{margin:18px 0 0;color:#f8f0dc;font-family:Georgia,serif;line-height:1.05}.woc-masthead__tagline span{display:block;font-size:clamp(23px,2.2vw,34px);font-style:italic}.woc-masthead__tagline strong{display:block;margin-top:5px;font:900 clamp(18px,1.8vw,27px)/1 sans-serif;letter-spacing:.28em;padding-left:.28em;color:#dcb655}
  .woc-vine{position:absolute;width:150px;height:90px;border-bottom:2px solid rgba(100,171,109,.63);bottom:48px}.woc-vine--left{left:8%;transform:rotate(14deg);border-radius:0 0 0 100%}.woc-vine--right{right:8%;transform:scaleX(-1) rotate(14deg);border-radius:0 0 0 100%}.woc-vine i{position:absolute;width:18px;height:9px;border-radius:100% 0 100% 0;background:linear-gradient(135deg,#88b66e,#315f39)}.woc-vine i:nth-child(1){left:24%;bottom:-1px;transform:rotate(-30deg)}.woc-vine i:nth-child(2){left:53%;bottom:8px;transform:rotate(28deg)}.woc-vine i:nth-child(3){left:78%;bottom:22px;transform:rotate(-25deg)}
  .woc-masthead__nav{position:relative;z-index:4;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:8px;max-width:1320px;margin:24px auto 0}.woc-masthead__nav a,.woc-masthead__nav span{display:flex;align-items:center;justify-content:center;min-height:38px;padding:8px 10px;border:1px solid rgba(219,186,100,.46);border-radius:999px;background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(0,0,0,.07));box-shadow:inset 0 1px 0 rgba(255,255,255,.13);color:#f7eed4;text-decoration:none;font:800 10px/1.2 sans-serif;letter-spacing:.1em;text-align:center}.woc-masthead__nav a:hover{background:rgba(216,178,82,.16)}
  .woc-vine-gather{position:relative;z-index:1;width:180px;height:30px;margin:2px auto -20px}.woc-vine-gather span{position:absolute;left:50%;bottom:0;width:85px;height:24px;border-bottom:1.5px solid rgba(84,148,91,.62);border-radius:50%}.woc-vine-gather span:nth-child(1){transform:translateX(-98%) rotate(12deg)}.woc-vine-gather span:nth-child(2){transform:translateX(-50%)}.woc-vine-gather span:nth-child(3){transform:translateX(-2%) rotate(-12deg)}
  @keyframes wocPulse{0%,100%{transform:scale(.78);opacity:.72}50%{transform:scale(1.18);opacity:1}}@keyframes wocPulseHalo{0%,100%{transform:scale(.8);opacity:.35}50%{transform:scale(1.08);opacity:.8}}
  @media(max-width:900px){.woc-masthead{min-height:auto;padding:22px 16px 24px}.woc-masthead__top{align-items:center}.woc-logo-capsule{width:min(62vw,310px)}.woc-live-orb{width:120px}.woc-masthead__center{margin:12px auto 0}.woc-network-word{font-size:clamp(58px,14vw,112px);letter-spacing:-.08em}.woc-vine{display:none}.woc-masthead__nav{grid-template-columns:repeat(4,1fr);margin-top:22px}.woc-masthead__nav a,.woc-masthead__nav span{min-height:34px;font-size:9px}.woc-vine-gather{margin-top:4px}}
  @media(max-width:540px){.woc-masthead__top{gap:10px}.woc-logo-capsule{width:64vw;max-width:255px;padding:8px 14px}.woc-live-orb{width:92px}.woc-live-orb__content{padding-top:22%}.woc-live-orb__date{font-size:7.5px}.woc-live-orb__time{font-size:14px}.woc-network-word{font-size:15.5vw;line-height:.86}.woc-the{font-size:15px;margin-top:3px}.woc-masthead__tagline{margin-top:14px}.woc-masthead__tagline span{font-size:23px}.woc-masthead__tagline strong{font-size:16px}.woc-masthead__nav{grid-template-columns:repeat(2,1fr);gap:6px}.woc-masthead__nav a,.woc-masthead__nav span{font-size:9px}}
  @media(prefers-reduced-motion:reduce){.woc-logo-slide{transition:none}.woc-live-orb__halo,.woc-live-orb__pulse{animation:none}}
</style>

<script>
  (function(){
    var root=document.currentScript && document.currentScript.previousElementSibling;
    root=document.querySelector('[data-network-masthead]');
    if(!root || root.dataset.ready==='1') return;
    root.dataset.ready='1';
    var slides=root.querySelectorAll('.woc-logo-slide');
    var reduced=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(slides.length>1 && !reduced){var i=0;setInterval(function(){slides[i].classList.remove('is-active');i=(i+1)%slides.length;slides[i].classList.add('is-active');},2500);}
    var dateEl=root.querySelector('[data-network-date]'),timeEl=root.querySelector('[data-network-time]');
    function tick(){var now=new Date();try{dateEl.textContent=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',month:'short',day:'numeric'}).format(now).toUpperCase();timeEl.textContent=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',hour:'numeric',minute:'2-digit'}).format(now)+' ET';}catch(e){dateEl.textContent=now.toLocaleDateString();timeEl.textContent=now.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});}}
    tick();setInterval(tick,30000);
  })();
</script>

