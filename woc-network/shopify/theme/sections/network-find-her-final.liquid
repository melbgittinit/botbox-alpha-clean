<section id="find-her" class="woc-module dark"><div class="woc-inner"><p class="eyebrow">{{ 'woc_final.find.pilot' | t }}</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.image != blank %}<figure class="find-rack-editorial">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '720,1100,1500,1800', sizes: '(min-width: 1000px) 1280px, 100vw', alt: 'Editorial FIND HER campaign scene at a retail book display; not inventory verification.' }}<figcaption>{{ 'woc_final.find.image_note' | t }}</figcaption></figure>{% endif %}<div class="grid"><div><div class="find-pilot-panel"><p class="eyebrow">FIND HER NEAR YOU</p><h3>Three places.<br>One shared discovery.</h3><ul><li>Georgia</li><li>Illinois</li><li>Northern Indiana</li></ul><p class="fine">Start with a display location. Tell us whether you found the book.</p></div></div><div><p>{{ section.settings.deck | escape }}</p><label for="find-region-{{ section.id }}">{{ 'woc_final.find.region' | t }}</label><select id="find-region-{{ section.id }}" data-find-region><option value="Georgia">{{ 'woc_final.find.ga' | t }}</option><option value="Illinois">{{ 'woc_final.find.il' | t }}</option><option value="Northern Indiana">{{ 'woc_final.find.in' | t }}</option></select><div class="actions"><a class="btn" href="{{ section.settings.locator_url | default: 'https://choicebooks.com/find-a-location/' }}" target="_blank" rel="noopener">{{ 'woc_final.find.locator' | t }}</a><a class="btn" href="#find-her-report" data-report-status="Found">{{ 'woc_final.find.found' | t }}</a><a class="btn" href="#find-her-report" data-report-status="Not found">{{ 'woc_final.find.missing' | t }}</a></div><p class="fine">{{ 'woc_final.find.disclaimer' | t }}</p><p class="fine">{{ 'woc_final.find.region_note' | t }}</p></div></div><div id="find-her-report" class="card"><h3>{{ 'woc_final.find.report' | t }}</h3>{% assign form_id = 'FindHerForm-' | append: section.id %}{% form 'contact', id: form_id %}{% if form.posted_successfully? %}<p role="status">{{ 'woc_final.find.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<input type="hidden" name="contact[campaign]" value="FIND HER"><input type="hidden" name="contact[title]" value="Women of the Bible for Women of Color"><div class="grid"><label>{{ 'woc_final.find.email' | t }}<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label><label>{{ 'woc_final.find.region' | t }}<select name="contact[region]" data-report-region required><option>Georgia</option><option>Illinois</option><option>Northern Indiana</option></select></label><label>{{ 'woc_final.find.store' | t }}<input name="contact[store_location]" autocomplete="off" required></label><label>{{ 'woc_final.find.zip' | t }}<input name="contact[zip]" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required></label><label>{{ 'woc_final.find.result' | t }}<select name="contact[result]" data-report-result><option value="Found">{{ 'woc_final.find.found_option' | t }}</option><option value="Not found">{{ 'woc_final.find.missing_option' | t }}</option></select></label><label>{{ 'woc_final.find.purchase' | t }}<select name="contact[purchase]"><option value="No">{{ 'woc_final.find.no_purchase' | t }}</option><option value="One copy">{{ 'woc_final.find.one' | t }}</option><option value="Multiple copies">{{ 'woc_final.find.multiple' | t }}</option></select></label><label class="full">{{ 'woc_final.find.story' | t }}<textarea name="contact[body]" rows="4"></textarea></label></div><p class="fine">{{ 'woc_final.find.privacy' | t }}</p><button class="btn" type="submit">{{ 'woc_final.find.submit' | t }}</button>{% endform %}</div></div></section>
{% stylesheet %}
 .woc-module{padding:76px 0;background:#f7efe4;color:#321d30}.woc-module.dark{background:radial-gradient(ellipse at top right,#48213d,transparent 65%),#170e1c;color:#fff5e7}.woc-module .woc-inner{width:min(1280px,calc(100% - 40px));margin:auto}.woc-module h2{font:clamp(38px,5.5vw,76px)/1.04 Georgia,serif;color:inherit;margin:12px 0 22px;letter-spacing:-.035em}.woc-module h3{font:32px/1.1 Georgia,serif;color:inherit;margin:10px 0 18px}.woc-module p{font-size:18px;line-height:1.65}.woc-module .eyebrow{font:700 12px/1.5 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#79591e}.woc-module.dark .eyebrow{color:#e1c27b}.woc-module .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.woc-module .card{padding:30px;border:1px solid #b4977955;border-radius:22px;background:#ffffff09}.woc-module .actions{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.woc-module .btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 24px;border-radius:28px;background:#633453;color:#fff;text-decoration:none;border:1px solid #b49779;cursor:pointer;font:700 16px/1.4 Arial,sans-serif}.woc-module.dark .btn{background:#e3c581;color:#241322}.woc-module label{display:block;font:600 16px/1.5 Arial,sans-serif}.woc-module input,.woc-module select,.woc-module textarea{width:100%;min-height:48px;margin:8px 0 18px;padding:12px;border:1px solid #aa8a76;border-radius:8px;background:#fffaf5;color:#321d30;font:16px/1.5 Arial,sans-serif}.woc-module details{border-top:1px solid #b4977966;padding:20px 0}.woc-module summary{cursor:pointer;font-weight:700;min-height:44px}.woc-module :focus-visible{outline:3px solid #af7c15;outline-offset:5px}.woc-module img{max-width:100%;height:auto;display:block;border-radius:18px}.woc-module .book-image{max-height:590px;width:auto;margin:auto;object-fit:contain}.woc-module .fine{font-size:15px;line-height:1.6}.woc-module .price{font:28px Georgia,serif}.woc-module .portrait{width:100%;height:350px;object-fit:cover}.woc-module .monogram{font:90px Georgia,serif;padding:70px 20px;color:#dfc17a;background:#321d30;text-align:center;border-radius:14px}.woc-module .gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.woc-module .full{grid-column:1/-1}.woc-module [id]{scroll-margin-top:30px}@media(max-width:700px){.woc-module{padding:50px 0}.woc-module .grid,.woc-module .gallery{grid-template-columns:1fr}.woc-module .woc-inner{width:calc(100% - 28px)}.woc-module .card{padding:22px}.woc-module .btn{width:100%}}
{% endstylesheet %}
{% schema %}{"name": "FIND HER", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "FIND HER."}, {"type": "textarea", "id": "deck", "label": "Introduction", "default": "Look for Women of the Bible for Women of Color at a Choice Books display. Tell us what you find, and help another woman discover her next good read."}, {"type": "image_picker", "id": "image", "label": "Campaign artwork"}, {"type": "url", "id": "locator_url", "label": "Choice Books display locator"}], "presets": [{"name": "FIND HER"}]}{% endschema %}{% javascript %}
function setupWocFind(root){if(root.dataset.findReady)return;root.dataset.findReady='true';const region=root.querySelector('[data-find-region]');const report=root.querySelector('[data-report-region]');if(!region||!report)return;region.addEventListener('change',()=>report.value=region.value);root.querySelectorAll('[data-report-status]').forEach(a=>a.addEventListener('click',()=>{report.value=region.value;root.querySelector('[data-report-result]').value=a.dataset.reportStatus;}));}
document.querySelectorAll('#find-her').forEach(setupWocFind);document.addEventListener('shopify:section:load',e=>e.target.querySelectorAll('#find-her').forEach(setupWocFind));
{% endjavascript %}

<style>
#shopify-section-{{ section.id }} > .woc-module{background:#000;color:#f5f0f6}#shopify-section-{{ section.id }} .eyebrow{color:#e1c27b}
</style>

<style>
#find-her .find-rack-editorial{margin:0 0 34px}#find-her .find-rack-editorial img{width:100%;height:auto;max-height:720px;object-fit:cover;border:1px solid #dfbd6844;box-shadow:0 24px 60px rgba(0,0,0,.28)}#find-her .find-rack-editorial figcaption{margin-top:12px;color:#cfc7d1;font-size:14px;line-height:1.5}\n#find-her .find-pilot-panel{padding:40px;background:#140d19;border:1px solid #dfbd6855;border-radius:18px;height:100%}#find-her .find-pilot-panel h3{font-size:42px}#find-her .find-pilot-panel ul{list-style:none;padding:0;margin:25px 0}#find-her .find-pilot-panel li{padding:18px 0;font:28px Georgia,serif;color:#e1c27b;border-bottom:1px solid #dfbd6833}
</style>
