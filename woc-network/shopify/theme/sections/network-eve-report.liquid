{% assign sid = 'eve-report-' | append: section.id %}
{% assign woc_logo = 'https://cdn.shopify.com/s/files/1/0766/0335/9530/files/women_of_color_logo_short_hair_orchid.jpg?v=1787984073' %}
<section id="{{ sid }}" class="eve-report-v2">
  <div class="eve-shell">
    <header class="eve-brandbar">
      <span class="eve-menu" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="eve-logo-lockup">
        <div class="eve-logo-glass"><img src="{{ woc_logo }}" alt="Women of Color" width="1881" height="836"></div>
        <span>THE NETWORK</span>
      </div>
      <span class="eve-search" aria-hidden="true"></span>
    </header>

    <div class="eve-hero">
      <div class="eve-hero-media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'eve-hero-photo', alt: section.settings.hero_image_alt }}
        {% else %}
          <img class="eve-hero-photo" src="https://cdn.shopify.com/s/files/1/0766/0335/9530/files/eve-editorial-conversation-hero.png?v=1789357663" alt="Editorial illustration of mature women enjoying conversation at a cafe table" width="1672" height="941" loading="lazy">
        {% endif %}
        <div class="eve-hero-shade"></div>
      </div>
      <div class="eve-hero-copy" data-eve-story data-story-title="{{ section.settings.hero_heading | escape }}" data-story-url="{{ section.settings.story_link | escape }}">
        <p class="eve-kicker">THE EVE REPORT</p>
        <span class="eve-rule" aria-hidden="true"></span>
        <h2>{{ section.settings.hero_heading }}</h2>
        <p class="eve-conversation">TODAY’S CONVERSATION</p>
        {% if section.settings.hero_deck != blank %}<p class="eve-deck">{{ section.settings.hero_deck }}</p>{% endif %}
        <div class="eve-actions">
          {% if section.settings.story_link != blank %}<a class="eve-btn eve-btn--gold" href="{{ section.settings.story_link }}">Read It <span>→</span></a>{% else %}<a class="eve-btn eve-btn--gold" href="#eve-five-title">Get the EVE Five <span>→</span></a>{% endif %}
          <button class="eve-btn eve-btn--clear" type="button" data-eve-share data-share-url="{% if section.settings.story_link != blank %}{{ section.settings.story_link }}{% else %}{{ shop.url }}{{ request.path }}{% endif %}">Send to a Sister <span>→</span></button>
          {% if section.settings.story_link != blank %}<button class="eve-save" type="button" data-eve-save aria-pressed="false"><span>♡</span> Save</button>{% endif %}
        </div>
        <p data-eve-status role="status" aria-live="polite"></p><button class="eve-gather-link" type="button" data-eve-gather data-gp-story-url="{{ section.settings.story_link | escape }}" data-gp-story-id="{{ section.settings.story_id | escape }}" data-gp-story-category="The Conversation" data-gp-story-image="{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1200 }}{% endif %}" data-gp-story-headline="{{ section.settings.hero_heading | escape }}" data-gp-story-question="{{ section.settings.story_question | escape }}" data-gp-story-scripture="{{ section.settings.story_scripture | escape }}">Gather Around This ↓</button>
      </div>
    </div>

    <div class="eve-five">
      <div class="eve-five-title"><i></i><h3 id="eve-five-title">THE EVE FIVE</h3><i></i></div>
      <p class="eve-five-deck">Five handpicked things worth knowing, enjoying, sharing or gathering around.</p>
      <div class="eve-five-grid">
        {% assign five_labels = 'The Conversation|The Look|The Taste|The Place|The Good Word' | split: '|' %}
        {% assign five_copy = 'Something worth talking about today.|Style, beauty and a little fabulousness.|Food, tables and something delicious.|Somewhere worth going or gathering.|A little faith and wisdom to carry.' | split: '|' %}
        {% for label in five_labels %}
          {% assign idx = forloop.index %}
          {% assign image_setting = '' %}
          {% case idx %}{% when 1 %}{% assign image_setting = section.settings.five_1_image %}{% when 2 %}{% assign image_setting = section.settings.five_2_image %}{% when 3 %}{% assign image_setting = section.settings.five_3_image %}{% when 4 %}{% assign image_setting = section.settings.five_4_image %}{% when 5 %}{% assign image_setting = section.settings.five_5_image %}{% endcase %}
          {% assign field_prefix = 'five_' | append: idx %}
          {% assign title_key = field_prefix | append: '_title' %}{% assign copy_key = field_prefix | append: '_copy' %}{% assign link_key = field_prefix | append: '_link' %}{% assign question_key = field_prefix | append: '_question' %}{% assign scripture_key = field_prefix | append: '_scripture' %}
          {% assign story_title = section.settings[title_key] | default: label %}
          {% assign story_copy = section.settings[copy_key] | default: five_copy[forloop.index0] %}
          {% assign story_link = section.settings[link_key] %}
          <article class="eve-five-item" data-eve-story data-story-title="{{ story_title | escape }}" data-story-url="{{ story_link | escape }}">
            <div class="eve-five-media">
              {% if image_setting != blank %}
                {{ image_setting | image_url: width: 700 | image_tag: loading: 'lazy', alt: label }}
              {% else %}
                <div class="eve-card-placeholder eve-card-placeholder--{{ idx }}"><span>{% case idx %}{% when 1 %}“ ”{% when 2 %}◇{% when 3 %}⌁{% when 4 %}⌖{% else %}✦{% endcase %}</span><small>{{ label }}</small></div>
              {% endif %}
              <span class="eve-five-icon">{% case idx %}{% when 1 %}“ ”{% when 2 %}◇{% when 3 %}⌁{% when 4 %}⌖{% else %}✦{% endcase %}</span>
            </div>
            <h4>{{ story_title | escape }}</h4><p>{{ story_copy | escape }}</p>
            {% if story_link != blank %}<div class="eve-card-actions"><a href="{{ story_link }}">Read It →</a><button type="button" data-eve-share>Send to a Sister</button><button type="button" data-eve-save aria-pressed="false"><span>♡</span> Save</button><button type="button" data-eve-gather data-gp-story-url="{{ story_link | escape }}" data-gp-story-id="{{ story_link | escape }}" data-gp-story-category="{{ label | escape }}" data-gp-story-image="{% if image_setting != blank %}{{ image_setting | image_url: width: 700 }}{% endif %}" data-gp-story-headline="{{ story_title | escape }}" data-gp-story-question="{{ section.settings[question_key] | escape }}" data-gp-story-scripture="{{ section.settings[scripture_key] | escape }}">Gather Around This ↓</button></div><p data-eve-status role="status" aria-live="polite"></p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="garden-entry" data-garden-entry>
      <div class="garden-vines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="garden-copy">
        <p class="garden-kicker">FROM THE EVE REPORT</p>
        <h3>GARDEN<br>PARTY</h3>
        <span class="garden-rule"></span>
        <p class="garden-lede">Something worth talking about?<br><strong>Bring the women together.</strong></p>
        {% if section.settings.builder_link != blank %}<a class="garden-cta" href="{{ section.settings.builder_link }}">Build My Garden Party <span>→</span></a>{% else %}<span class="garden-cta is-preview">Build My Garden Party <span>→</span></span>{% endif %}
        <p class="garden-note">You do not need a garden.<br>You only need someone you would love to see.</p>
      </div>
      <div class="garden-media">
        {% if section.settings.garden_image != blank %}
          {{ section.settings.garden_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.garden_image_alt }}
        {% else %}
          <div class="garden-placeholder" aria-label="Garden Party image space awaiting approved photography">
            <div class="garden-table" aria-hidden="true"><span></span><span></span><span></span><span></span><b></b></div>
            <p>GATHER • TALK • LAUGH • GROW</p>
          </div>
        {% endif %}
        <div class="garden-glow" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
<style>
#{{ sid }}{background:#f6f0e7;color:#102b20;padding:0 0 96px;overflow:hidden}#{{ sid }} .eve-shell{width:min(1480px,calc(100% - 36px));margin:0 auto;background:#fffaf3;border-radius:0 0 38px 38px;overflow:hidden;box-shadow:0 34px 76px rgba(21,38,29,.12)}
#{{ sid }} .eve-brandbar{height:150px;background:linear-gradient(135deg,#062319,#0b3928);display:grid;grid-template-columns:100px 1fr 100px;align-items:center;padding:0 42px;color:#dfbd68}.eve-logo-lockup{display:flex;flex-direction:column;align-items:center;gap:8px}.eve-logo-glass{width:min(520px,56vw);height:72px;padding:6px 18px;border:1px solid rgba(236,205,132,.42);border-radius:999px;background:rgba(255,250,240,.95);overflow:hidden}.eve-logo-glass img{width:100%;height:100%;object-fit:contain}.eve-logo-lockup>span{font:800 11px Arial;letter-spacing:.42em;color:#e6c878;margin-left:.42em}.eve-menu{display:grid;gap:8px;width:46px}.eve-menu i{height:2px;background:#e2be68}.eve-search{justify-self:end;width:30px;height:30px;border:3px solid #e2be68;border-radius:50%;position:relative}.eve-search:after{content:"";position:absolute;width:14px;height:3px;background:#e2be68;right:-10px;bottom:-5px;transform:rotate(45deg)}
#{{ sid }} .eve-hero{position:relative;min-height:860px;background:#08251b;overflow:hidden}.eve-hero-media{position:absolute;inset:0}.eve-hero-photo{width:100%;height:100%;object-fit:cover}.eve-hero-placeholder{position:absolute;inset:0;background:radial-gradient(circle at 72% 32%,rgba(220,183,89,.20),transparent 20%),radial-gradient(circle at 60% 60%,rgba(70,132,94,.24),transparent 28%),linear-gradient(135deg,#062319,#0d4630 56%,#07281d);overflow:hidden}.eve-placeholder-label{position:absolute;right:8%;top:12%;font:900 clamp(80px,12vw,170px)/.85 Georgia,serif;color:rgba(255,255,255,.035);letter-spacing:-.05em}.eve-light-tree{position:absolute;right:8%;top:9%;width:50%;height:82%}.eve-light-tree b{position:absolute;left:48%;bottom:0;width:2px;height:58%;background:linear-gradient(transparent,#e6c168 30%,#e6c168);box-shadow:0 0 12px rgba(230,193,104,.45)}.eve-light-tree:before,.eve-light-tree:after{content:"";position:absolute;left:49%;bottom:48%;width:46%;height:1px;background:linear-gradient(90deg,#e5c36f,transparent);transform-origin:left center;transform:rotate(-31deg);box-shadow:0 0 10px rgba(229,195,111,.32)}.eve-light-tree:after{transform:rotate(31deg)}.eve-light-tree i{position:absolute;width:9px;height:9px;border-radius:50%;background:#e6c36c;box-shadow:0 0 20px #e6c36c}.eve-light-tree i:nth-child(1){left:27%;top:26%}.eve-light-tree i:nth-child(2){left:63%;top:18%}.eve-light-tree i:nth-child(3){left:76%;top:44%}.eve-light-tree i:nth-child(4){left:18%;top:53%}.eve-light-tree i:nth-child(5){left:48%;top:8%}.eve-hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,17,12,.95),rgba(2,17,12,.75) 39%,rgba(2,17,12,.12) 76%),linear-gradient(0deg,rgba(2,17,12,.75),transparent 45%)}
#{{ sid }} .eve-hero-copy{position:absolute;left:7.5%;bottom:8%;z-index:3;width:min(700px,78%);color:#fff8eb}.eve-kicker{margin:0;color:#e2bf6d;font:700 23px Arial;letter-spacing:.12em}.eve-rule{display:block;width:190px;height:2px;background:#e2bf6d;margin:18px 0 30px}.eve-hero h2{margin:0;font:clamp(56px,6.8vw,96px)/.98 Georgia,serif;letter-spacing:-.045em}.eve-conversation{margin:36px 0 12px;color:#e4c36f;font:800 13px Arial;letter-spacing:.2em}.eve-deck{max-width:620px;font:18px/1.55 Georgia,serif;color:#f0e7da}.eve-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:25px}.eve-btn{min-height:58px;padding:0 25px;border-radius:7px;display:inline-flex;align-items:center;justify-content:space-between;gap:35px;text-decoration:none;font:21px Georgia,serif;cursor:pointer}.eve-btn--gold{border:1px solid #d5ad4f;color:#fff8eb;background:rgba(7,45,32,.68)}.eve-btn--clear{border:1px solid rgba(255,255,255,.78);color:#fff;background:rgba(0,0,0,.18)}.eve-btn.is-preview{opacity:.62}.eve-save,.eve-gather-link{border:0;background:transparent;cursor:pointer}.eve-save{color:#ead8b8;padding:12px}.eve-gather-link{margin-top:22px;color:#e4c36f;font:20px Georgia,serif;padding:8px 0}
#{{ sid }} .eve-five{padding:58px 30px 72px}.eve-five-title{display:flex;align-items:center;justify-content:center;gap:28px}.eve-five-title i{height:1px;background:#c59a44;flex:1;max-width:330px}.eve-five-title h3{margin:0;font:800 27px Arial;letter-spacing:.15em}.eve-five-deck{max-width:760px;margin:16px auto 34px;text-align:center;color:#6d625c;font:16px/1.5 Georgia,serif}.eve-five-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.eve-five-item{text-align:center}.eve-five-media{position:relative;height:330px;border-radius:28px;overflow:hidden;box-shadow:0 16px 32px rgba(32,38,29,.1)}.eve-five-media>img{width:100%;height:100%;object-fit:cover}.eve-card-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;background:radial-gradient(circle at 50% 35%,rgba(222,187,97,.17),transparent 25%),linear-gradient(145deg,#123c2c,#08251b);color:#e5c36d}.eve-card-placeholder span{font:52px Georgia,serif}.eve-card-placeholder small{font:800 9px Arial;letter-spacing:.15em;text-transform:uppercase;color:#f1e2bd}.eve-card-placeholder--2{background:linear-gradient(145deg,#4b1740,#1e3b2d)}.eve-card-placeholder--3{background:linear-gradient(145deg,#774d31,#1b402f)}.eve-card-placeholder--4{background:linear-gradient(145deg,#164b3c,#14293c)}.eve-card-placeholder--5{background:linear-gradient(145deg,#0b3325,#3d2548)}.eve-five-icon{position:absolute;left:50%;bottom:0;transform:translate(-50%,35%);width:70px;height:70px;border-radius:50%;display:grid;place-items:center;background:#073524;border:1px solid #cda64e;color:#e2bd64;font:26px Georgia,serif}.eve-five-item h4{margin:43px 0 7px;font:29px Georgia,serif}.eve-five-item p{margin:0 auto;max-width:190px;color:#786d65;font:14px/1.4 Georgia,serif}
#{{ sid }} .garden-entry{position:relative;margin:0 22px 24px;min-height:650px;border-radius:34px;overflow:hidden;display:grid;grid-template-columns:.78fr 1.22fr;background:linear-gradient(135deg,#082e20,#0a3826 62%,#123b2b);color:#fff4dd}.garden-copy{position:relative;z-index:4;padding:68px 20px 68px 70px;display:flex;flex-direction:column;justify-content:center}.garden-kicker{font:800 10px Arial;letter-spacing:.2em;color:#e3c26e}.garden-copy h3{font:clamp(72px,8vw,118px)/.82 Georgia,serif;color:#dfbb64;margin:0;letter-spacing:-.035em}.garden-rule{width:150px;height:1px;background:#d9b55d;margin:26px 0}.garden-lede{font:25px/1.35 Georgia,serif}.garden-cta{display:inline-flex;align-self:flex-start;justify-content:space-between;gap:48px;background:#6a1648;color:#fff;border:1px solid rgba(230,189,95,.35);border-radius:8px;min-height:60px;padding:0 26px;align-items:center;text-decoration:none;font:22px Georgia,serif}.garden-cta.is-preview{opacity:.65}.garden-note{font:italic 21px/1.35 Georgia,serif;color:#e5bf66;margin-top:28px}.garden-media{position:relative;min-height:650px}.garden-media>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.garden-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(circle at 58% 28%,rgba(225,189,96,.22),transparent 24%),linear-gradient(145deg,#0f4934,#092c20);color:#ddc174}.garden-placeholder p{font:800 10px Arial;letter-spacing:.22em;margin-top:30px}.garden-table{position:relative;width:360px;height:250px}.garden-table b{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);width:260px;height:60px;border:2px solid rgba(222,190,103,.65);border-radius:50%;box-shadow:0 0 30px rgba(222,190,103,.13)}.garden-table span{position:absolute;width:58px;height:58px;border-radius:50%;border:1px solid rgba(223,192,105,.7);box-shadow:0 0 20px rgba(223,192,105,.12)}.garden-table span:nth-child(1){left:45px;top:70px}.garden-table span:nth-child(2){left:145px;top:22px}.garden-table span:nth-child(3){right:42px;top:75px}.garden-table span:nth-child(4){left:153px;bottom:72px}.garden-glow{position:absolute;inset:0;background:radial-gradient(circle at 62% 18%,rgba(229,191,100,.22),transparent 23%);pointer-events:none}.garden-vines{position:absolute;left:0;bottom:0;width:44%;height:75%;z-index:3;opacity:.6}.garden-vines:before,.garden-vines:after{content:"";position:absolute;left:26px;bottom:-60px;width:180px;height:620px;border-left:1px solid #caa24d;border-radius:60% 0 0 0;transform:rotate(-9deg)}.garden-vines:after{left:74px;height:510px;transform:rotate(12deg)}.garden-vines i{position:absolute;width:45px;height:22px;border:1px solid #caa24d;border-radius:100% 0 100% 0}.garden-vines i:nth-child(1){left:42px;bottom:210px}.garden-vines i:nth-child(2){left:86px;bottom:325px}.garden-vines i:nth-child(3){left:40px;bottom:430px}.garden-vines i:nth-child(4){left:112px;bottom:480px}.garden-vines i:nth-child(5){left:65px;bottom:110px}
@media(max-width:1050px){#{{ sid }} .eve-five-grid{grid-template-columns:repeat(5,220px);overflow-x:auto}.garden-entry{grid-template-columns:1fr}.garden-media{min-height:420px;order:-1}.garden-copy{padding:52px 38px}.garden-vines{display:none}}
@media(max-width:760px){#{{ sid }}{padding-bottom:50px}#{{ sid }} .eve-shell{width:100%;border-radius:0;box-shadow:none}.eve-brandbar{height:116px;grid-template-columns:45px 1fr 45px;padding:0 18px}.eve-logo-glass{width:min(360px,66vw);height:60px}.eve-hero{min-height:790px}.eve-light-tree{right:-6%;width:75%}.eve-hero-shade{background:linear-gradient(0deg,rgba(2,17,12,.96),rgba(2,17,12,.72) 58%,rgba(2,17,12,.12))}.eve-hero-copy{left:24px;right:24px;bottom:40px;width:auto}.eve-hero h2{font-size:52px}.eve-btn{width:100%;min-height:54px}.eve-five{padding:46px 18px 55px}.eve-five-title h3{font-size:20px;white-space:nowrap}.eve-five-grid{grid-template-columns:repeat(5,195px)}.eve-five-media{height:265px}.garden-entry{margin:0 12px 12px;border-radius:28px}.garden-media{min-height:330px}.garden-table{transform:scale(.72)}.garden-copy{padding:42px 26px 52px}.garden-copy h3{font-size:76px}.garden-cta{width:100%;box-sizing:border-box;font-size:19px;gap:18px}}
</style>
<script>(function(){const r=document.getElementById({{ sid | json }});if(!r)return;r.querySelectorAll('[data-eve-story]').forEach(story=>{const note=story.querySelector('[data-eve-status]');const sh=story.querySelector('[data-eve-share]');const getUrl=()=>new URL(story.dataset.storyUrl||sh.dataset.shareUrl||location.pathname,location.origin).href;if(sh)sh.addEventListener('click',async()=>{const d={title:story.dataset.storyTitle||'The EVE Report — Women of Color',text:'Something from The EVE Report worth sharing.',url:getUrl()};try{if(navigator.share)await navigator.share(d);else{await navigator.clipboard.writeText(d.url);note.textContent='Link copied. Paste it into a message to your sister.';}}catch(e){if(e.name!=='AbortError')note.textContent='Share this page by copying its address from your browser.';}});const s=story.querySelector('[data-eve-save]');if(s)s.addEventListener('click',()=>{try{const url=getUrl();const existing=JSON.parse(localStorage.getItem('woc-eve-saved')||'[]');const saved=Array.isArray(existing)?existing:[];if(!saved.includes(url))saved.push(url);localStorage.setItem('woc-eve-saved',JSON.stringify(saved.slice(-50)));note.replaceChildren(document.createTextNode('Saved in this browser. '));const a=document.createElement('a');a.href=url;a.textContent='Open saved story';a.style.color='inherit';note.append(a);s.setAttribute('aria-pressed','true');s.querySelector('span').textContent='♥';}catch(e){note.textContent='Browser saving is unavailable. Bookmark this story to keep it.';}});});})();</script>
{% schema %}{"name": "THE EVE Report", "settings": [{"type": "image_picker", "id": "hero_image", "label": "EVE hero photograph"}, {"type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "Women gathering and enjoying conversation."}, {"type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Fun \u2022 Fashion \u2022 Food \u2022 Faith \u2022 Fabulous Ways to Gather"}, {"type": "textarea", "id": "hero_deck", "label": "Hero deck", "default": "What women are talking about, going to, gathering around and passing along."}, {"type": "url", "id": "story_link", "label": "Today\u2019s conversation story link"}, {"type": "image_picker", "id": "five_1_image", "label": "EVE Five \u2014 Conversation image"}, {"type": "image_picker", "id": "five_2_image", "label": "EVE Five \u2014 Look image"}, {"type": "image_picker", "id": "five_3_image", "label": "EVE Five \u2014 Taste image"}, {"type": "image_picker", "id": "five_4_image", "label": "EVE Five \u2014 Place image"}, {"type": "image_picker", "id": "five_5_image", "label": "EVE Five \u2014 Good Word image"}, {"type": "image_picker", "id": "garden_image", "label": "Garden Party photograph"}, {"type": "text", "id": "garden_image_alt", "label": "Garden Party image alt text", "default": "Women gathered around a table for a Garden Party."}, {"type": "url", "id": "builder_link", "label": "Garden Party builder link"}, {"type": "text", "id": "story_id", "label": "Story identifier"}, {"type": "textarea", "id": "story_question", "label": "Garden Party conversation question"}, {"type": "text", "id": "story_scripture", "label": "Optional story Scripture reference"}, {"type": "text", "id": "five_1_title", "label": "Five 1 \u2014 Headline"}, {"type": "textarea", "id": "five_1_copy", "label": "Five 1 \u2014 Summary"}, {"type": "url", "id": "five_1_link", "label": "Five 1 \u2014 Story link"}, {"type": "textarea", "id": "five_1_question", "label": "Five 1 \u2014 Gathering question"}, {"type": "text", "id