 0}.gp-app .gp-status{color:#173c2e;font-weight:700}.gp-app .gp-status:empty{display:none}.gp-app .gp-reveal-photo{display:block;width:100%;height:280px;object-fit:cover;object-position:center 43%;border-radius:14px;margin-bottom:24px}.gp-app .gp-edit-title input{font:italic 30px/1.2 Georgia,serif!important;color:#70204f!important}.gp-app .gp-stats{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #c6b388;margin:22px 0;text-align:center}.gp-app .gp-stats div{padding:16px 8px;font:20px Georgia,serif}.gp-app .gp-stats small{display:block;font:11px Arial;letter-spacing:.1em;color:#6b6053;margin-top:6px}.gp-app details{border-bottom:1px solid #d9caa9;padding:0 0 14px;margin-bottom:8px}.gp-app summary{cursor:pointer;font:23px/1.4 Georgia;color:#173c2e;padding:16px 0;min-height:56px}.gp-app :focus-visible{outline:3px solid #20654d;outline-offset:3px}.gp-app h2:focus{outline:none}
