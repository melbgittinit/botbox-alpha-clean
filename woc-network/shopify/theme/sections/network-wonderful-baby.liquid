<section class="network-baby"><div class="network-baby-inner">{% if section.settings.cover_image != blank %}<div class="network-baby-cover">{{ section.settings.cover_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 680, 1000', sizes: '(max-width: 700px) 85vw, 400px' }}</div>{% endif %}<div class="network-baby-copy"><p class="eyebrow">FOR THE LITTLE ONES</p><h2>{{ section.settings.heading | escape }}</h2><p>A little book to share, read together, and give with love.</p><a href="{{ section.settings.amazon_url }}" target="_blank" rel="noopener">Find the book on Amazon →</a>{% if section.settings.future_note != blank %}<p class="network-baby-future">{{ section.settings.future_note | escape }}</p>{% endif %}</div></div></section>
{% stylesheet %}.network-baby{padding:65px 24px;background:#000;color:#eee}.network-baby>div{max-width:1280px;margin:auto;border-top:1px solid #d6ba7555;border-bottom:1px solid #d6ba7555;padding:40px 0}.network-baby h2{font:clamp(36px,5vw,64px)/1.1 Georgia,serif;color:#fff;margin:12px 0}.network-baby .eyebrow{font-size:11px;letter-spacing:.18em;color:#dfbd68}.network-baby a{display:inline-flex;align-items:center;min-height:48px;color:#e1c27b;font-weight:700}.network-baby p{font-size:18px}.network-baby-inner{display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);gap:clamp(28px,5vw,80px);align-items:center}.network-baby-cover img{display:block;width:100%;height:auto;object-fit:contain;border-radius:8px}.network-baby .network-baby-future{font-size:15px;color:#bdb6bd;margin-top:28px;max-width:48ch}@media(max-width:700px){.network-baby-inner{grid-template-columns:1fr}.network-baby-cover{max-width:360px;margin:auto}}{% endstylesheet %}
{% schema %}{"name":"Wonderful Baby Bible","settings":[{"type":"image_picker","id":"cover_image","label":"Book cover"},{"type":"textarea","id":"future_note","label":"Future Wonderful collection note"},{"type":"text","id":"heading","label":"Heading","default":"The Wonderful Baby Bible"},{"type":"url","id":"amazon_url","label":"Amazon book listing"}],"presets":[{"name":"Wonderful Baby Bible"}]}{% endschema %}