DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botbox"

# FAST PAY is intentionally inert unless this is exactly "true".
FAST_PAY_ENABLED="false"

# Exact origin that Stripe should return users to after checkout.
FAST_PAY_APP_ORIGIN="http://localhost:3000"

# Stripe server credentials. Keep server-side only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# HUB identity/session layer. Never expose these values as NEXT_PUBLIC_* variables.
SHOPIFY_STORE_DOMAIN="urbanspirit.biz"
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=""
HUB_AUTH_ORIGIN="http://localhost:3000"
HUB_AUTH_SUCCESS_PATH="/hub"
HUB_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Legacy staging-only bearer token retained for maintenance/admin routes while needed.
# Public FAST PAY action and checkout routes use the signed HUB session instead.
FAST_PAY_INTERNAL_TOKEN="replace-with-a-long-random-secret"
