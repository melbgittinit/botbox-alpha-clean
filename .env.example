DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botbox"

# FAST PAY is intentionally inert unless this is exactly "true".
FAST_PAY_ENABLED="false"

# Server-only bearer token for staging/internal calls until HUB authentication is wired.
# Never expose this in NEXT_PUBLIC_* variables or client-side JavaScript.
FAST_PAY_INTERNAL_TOKEN="replace-with-a-long-random-secret"

# Exact origin that Stripe should return users to after checkout.
FAST_PAY_APP_ORIGIN="http://localhost:3000"

# Stripe server credentials. Keep server-side only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
